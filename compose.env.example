# Variables de Docker Compose (NO son las de Laravel).
# Copiar a compose.env y ajustar si hace falta:
#   cp compose.env.example compose.env

# UID/GID del host para que los bind mounts no queden como root.
UID=1000
GID=1000

# 1 = incluir Android SDK + adb en la imagen; 0 = imagen solo-PHP.
WITH_ANDROID=1

# Zona horaria del contenedor. Si se deja vacío, el Makefile toma la del host.
# Ejemplo: America/Argentina/Buenos_Aires
TZ=

# GID del grupo dueño de /dev/kvm (vacío = lo detecta el Makefile).
KVM_GID=

# Heap del daemon de Gradle (MB). Bajar si la máquina tiene poca RAM.
GRADLE_HEAP=2048

# Emulador headless: RAM y API del sistema.
EMULATOR_MEMORY=1536
ANDROID_API=35

# IP LAN del host que ve el teléfono (para `make jump` y el QR).
# Ejemplo: 192.168.1.42
JUMP_IP=
